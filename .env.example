# Database connection string (default is local zero-config SQLite)
# For PostgreSQL: postgresql+psycopg://username:password@localhost:5432/leads
DATABASE_URL=sqlite:///./data/leads.db

# Lead enrichment mode: 'off' | 'mock' | 'http'
ENRICHMENT_MODE=mock

# External enrichment API settings (used when ENRICHMENT_MODE=http)
ENRICHMENT_API_URL=
ENRICHMENT_API_KEY=
ENRICHMENT_TIMEOUT_SECONDS=5

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
